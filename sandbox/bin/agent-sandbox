#!/usr/bin/env bash
# Creates (once) and attaches to a clone-mode sandbox for a repository, running Claude Code as markeli-agent.
# Usage: agent-sandbox [--no-attach] [--recreate] [--yes] [--name NAME] [REPO_PATH] [-- CLAUDE_ARGS...]
set -euo pipefail

script_dir=$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)
kit="${AGENT_SANDBOX_KIT:-$script_dir/../kits/markeli-claude}"
agent_sock="${AGENT_SSH_SOCK:-$HOME/.ssh/markeli-agent.sock}"
agent_key="${AGENT_SSH_KEY:-$HOME/.ssh/markeli_agent}"
pull="${AGENT_SANDBOX_PULL:-missing}"

repo="."
no_attach=0
recreate=0
yes=0
name=""

die() { echo "agent-sandbox: $*" >&2; exit 1; }

while [[ $# -gt 0 && "$1" != "--" ]]; do
	case "$1" in
		--no-attach)
			no_attach=1
			shift
			;;
		--recreate)
			recreate=1
			shift
			;;
		--yes)
			yes=1
			shift
			;;
		--name)
			[[ $# -ge 2 ]] || die "--name requires an argument"
			[[ -n "$2" ]] || die "--name must not be empty; omit --name to use the repo-derived name"
			name=$2
			shift 2
			;;
		*)
			repo=$1
			shift
			;;
	esac
done
[[ "${1:-}" == "--" ]] && shift

repo=$(git -C "$repo" rev-parse --show-toplevel)
[[ -n "$name" ]] || name=$(basename "$repo" | tr '[:upper:]' '[:lower:]' | tr '._' '--')
[[ "$name" =~ ^[a-z0-9][a-z0-9-]*$ ]] \
	|| die "invalid sandbox name '$name': use lowercase letters, digits and hyphens, starting with a letter or digit"

ensure_bot_agent() {
	if ! SSH_AUTH_SOCK="$agent_sock" ssh-add -l >/dev/null 2>&1; then
		rm -f "$agent_sock"
		ssh-agent -a "$agent_sock" >/dev/null
		# The passphrase comes from the login keychain after the first interactive ssh-add --apple-use-keychain
		SSH_AUTH_SOCK="$agent_sock" ssh-add --apple-use-keychain "$agent_key" 2>/dev/null \
			|| die "cannot load $agent_key into $agent_sock"
	fi
	local configured
	configured=$(sbx settings get ssh.agentSocketPath 2>/dev/null || true)
	[[ "$configured" == "$agent_sock" ]] \
		|| die "sbx forwards '$configured', expected '$agent_sock':" \
			"run sbx settings set ssh.agentSocketPath $agent_sock && sbx daemon restart"
}

bind_secret() {
	local service=$1 item=$2
	security find-generic-password -s "$item" >/dev/null 2>&1 || die "keychain item $item not found"
	sbx secret set "$service" --sandbox "$name" --command "/usr/bin/security find-generic-password -s $item -w" >/dev/null
}

sandbox_exists() {
	sbx ls 2>/dev/null | awk 'NR > 1 { print $1 }' | grep -qx "$name"
}

# Clone mode adds a "sandbox-<name>" git remote to the host repo, served by a git-daemon inside the sandbox
# (see sandbox/README.md). That lets us check for commits the sandbox has that origin doesn't, without any
# access to the sandbox itself. It cannot see uncommitted/staged-but-not-committed changes in the sandbox's
# working tree (git-daemon only serves refs) — recreate does not guard against losing those.
recreate_sandbox() {
	# The sandbox-<name> remote (and its git-daemon) only exists while the sandbox is running, so a
	# stopped sandbox must be started before it can be fetched. `sbx exec` starts a stopped sandbox as
	# a side effect of running a command in it; `true` is a no-op we only use for that side effect.
	sbx exec "$name" true >/dev/null || die "cannot start sandbox-$name"
	git -C "$repo" fetch "sandbox-$name" --quiet \
		|| die "cannot fetch sandbox-$name; is the sandbox still running? (sbx ls)"
	local unpushed
	unpushed=$(git -C "$repo" rev-list --remotes="sandbox-$name" --not --remotes=origin | head -1) \
		|| die "cannot compare sandbox-$name against origin"
	[[ -z "$unpushed" ]] \
		|| die "sandbox-$name has commits not pushed to origin (e.g. $unpushed); push them first, then retry --recreate"
	if [[ $yes -eq 1 ]]; then
		sbx rm --force "$name"
	else
		sbx rm "$name"
	fi
}

# Prints the image and version the sandbox runs; whatever can't be read shows as unknown and never fails the launcher.
# sbx inspect doesn't document its field names, so this takes the first image reference with a digest it finds.
print_image() {
	local inspect image=unknown version=unknown release
	if command -v jq >/dev/null && inspect=$(sbx inspect "$name" --json 2>/dev/null); then
		image=$(jq -r '
			[.. | strings | select(test("@sha256:[0-9a-f]{64}"))][0]
			// (([.. | objects | to_entries[] | select(.key | test("image"; "i")) | .value | strings | select(startswith("sha256:") | not)][0] // "unknown")
				+ "@" + ([.. | strings | select(test("^sha256:[0-9a-f]{64}$"))][0] // "unknown"))
		' <<<"$inspect" 2>/dev/null) || image=unknown
		[[ $image != unknown@unknown ]] || image=unknown
	fi
	# Images from before 1.0.0 have no image-release file
	if release=$(sbx exec "$name" sh -c 'cat /etc/claude-code/image-release 2>/dev/null || echo VERSION=unversioned' 2>/dev/null); then
		version=$(sed -n 's/^VERSION=//p' <<<"$release")
	fi
	echo "agent-sandbox: $name runs ${image:-unknown}, version ${version:-unknown}"
}

ensure_bot_agent

if [[ $recreate -eq 1 ]] && sandbox_exists; then
	recreate_sandbox
fi

if ! sandbox_exists; then
	# Sandbox-scoped secrets can exist before the sandbox; the kit's first-run approval then finds them
	bind_secret github agent/personal-github
	bind_secret gitlab agent/personal-gitlab
	sbx create --clone --pull "$pull" --name "$name" "$kit" "$repo"
fi

print_image

if [[ $no_attach -eq 1 ]]; then
	echo "agent-sandbox: $name ready (not attached)"
	exit 0
fi

if [[ $# -eq 0 ]]; then
	exec sbx run --name "$name"
fi
exec sbx run --name "$name" -- "$@"
