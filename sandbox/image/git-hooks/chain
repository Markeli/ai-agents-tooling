#!/bin/sh
# The image sets core.hooksPath system-wide, which makes git ignore the repository's own hooks directory. Every
# standard hook name links here so the repository's hook still runs, with the same arguments, stdin and exit code.
# git init runs reference-transaction before the repository is complete; with no repository there is no hook to run.
hooks=$(git rev-parse --path-format=absolute --git-common-dir 2>/dev/null)/hooks || exit 0
hook=$hooks/$(basename "$0")
if [ -x "$hook" ] && [ ! "$hook" -ef "$0" ]; then
	exec "$hook" "$@"
fi
