<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<OutputType>Exe</OutputType>
		<!-- Also the program name that help and parse errors show -->
		<AssemblyName>agent-sandbox</AssemblyName>
		<RootNamespace>AgentSandbox</RootNamespace>
		<PackAsTool>true</PackAsTool>
		<ToolCommandName>agent-sandbox</ToolCommandName>
		<PackageId>AgentSandbox</PackageId>
		<Version>1.0.0</Version>
		<Description>Creates (once) and attaches to a Docker Sandbox running Claude Code as markeli-agent.</Description>
		<RollForward>Major</RollForward>
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="System.CommandLine" />
	</ItemGroup>

	<ItemGroup>
		<!-- The kit ships inside the tool, which can't find sandbox/kits from where it is installed (docs/adr/0003) -->
		<EmbeddedResource Include="../../../kits/markeli-claude/**" LogicalName="kit/markeli-claude/%(RecursiveDir)%(Filename)%(Extension)" />
	</ItemGroup>

	<ItemGroup>
		<InternalsVisibleTo Include="AgentSandbox.Tests" />
	</ItemGroup>

</Project>
