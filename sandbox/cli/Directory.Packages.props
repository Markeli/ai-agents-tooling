<Project>
	<PropertyGroup>
		<ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
	</PropertyGroup>
	<ItemGroup>
		<PackageVersion Include="System.CommandLine" Version="2.0.15" />
	</ItemGroup>
	<ItemGroup Label="Tests">
