<?xml version="1.0" encoding="utf-8"?>
<configuration>
	<!-- Only nuget.org, whatever the machine's own NuGet.Config adds: with central package management a second
	     source is NU1507, an error here because warnings are errors -->
	<packageSources>
		<clear />
		<add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
	</packageSources>
</configuration>
